# ── Public site URL ──
# Inlined at BUILD time (NEXT_PUBLIC_*). Used for canonical URLs, the sitemap
# and JSON-LD. Must match the domain you actually serve from.
NEXT_PUBLIC_SITE_URL=https://en2.tech

# ── Caddy / TLS ──
SITE_DOMAIN=en2.tech
ACME_EMAIL=john@en2.tech

# ── Email delivery (Resend) ──
# Create a key at https://resend.com and verify the en2.tech domain first.
# Without a key the contact form still works — submissions are logged to the
# container's stdout instead of emailed, and the response says so.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=john@en2.tech

# Must be on a domain verified in Resend, or delivery is rejected.
CONTACT_FROM_EMAIL=EN2 Tech <noreply@en2.tech>

# ── Reverse proxy ──
# Set to "true" ONLY when the app sits behind a proxy that sets
# X-Forwarded-For (it does under docker-compose). If left unset in
# production, every visitor shares one rate-limit bucket.
TRUST_PROXY_HEADERS=true
